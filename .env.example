# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (DEVSECOPS GUIDELINES)
# ==============================================================================
# SECURITY NOTICE:
# 1. NEVER commit actual API keys, credentials, or secrets to Git.
# 2. In Vite applications, ANY variable prefixed with `VITE_` is automatically
#    baked into client-side JavaScript bundles and exposed publicly to anyone.
# 3. Secret keys (e.g., GEMINI_API_KEY, database passwords, service role keys)
#    MUST NOT be prefixed with `VITE_`.
# 4. If AI capabilities are connected, proxy requests via an authenticated backend
#    service rather than calling AI APIs directly from client browser bundles.
# ==============================================================================

# GEMINI_API_KEY: Server-side Gemini API key (DO NOT prefix with VITE_).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The deployment origin URL for production or local development.
APP_URL="https://example.com"
